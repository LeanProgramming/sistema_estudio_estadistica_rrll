{
  "titulo": "Formulas por unidad",
  "secciones": [
    {
      "unidad": "Unidad I - Introduccion",
      "formulas": [
        {
          "nombre": "Tamaño de muestra (poblacion infinita)",
          "formula": "n = \\left(\\frac{Z_{\\alpha/2}\\cdot \\sigma}{E}\\right)^2",
          "uso": "Calcular n para estimar una media con margen de error E."
        },
        {
          "nombre": "Tamaño de muestra (poblacion finita)",
          "formula": "n = \\frac{n_0}{1 + \\frac{n_0-1}{N}}",
          "uso": "Ajuste del tamaño de muestra para poblacion finita N."
        },
        {
          "nombre": "Elemento muestral (muestreo sistematico)",
          "formula": "\\text{ELEMENTO}_i = \\text{ENTERO}[(N)\\cdot(x_{ai}) + 1]",
          "uso": "Seleccionar elementos de la muestra con numeros aleatorios."
        },
        {
          "nombre": "Progresion (muestreo sistematico)",
          "formula": "p = \\frac{N}{n}",
          "uso": "Intervalo entre elementos seleccionados."
        },
        {
          "nombre": "Arranque (muestreo sistematico)",
          "formula": "a = \\text{ENTERO}[(p)(x_a) + 1]",
          "uso": "Primer elemento de la muestra sistematica."
        },
        {
          "nombre": "Tamano de muestra estratificada",
          "formula": "n = \\sum n_h",
          "uso": "Suma de los tamanos de cada estrato."
        }
      ]
    },
    {
      "unidad": "Unidad II - Analisis de dos variables",
      "formulas": [
        {
          "nombre": "Recta de regresion",
          "formula": "y = a + b\\,x",
          "uso": "Modelo lineal entre dos variables."
        },
        {
          "nombre": "Pendiente (minimos cuadrados)",
          "formula": "b = \\frac{n\\sum xy - \\sum x\\sum y}{n\\sum x^2 - (\\sum x)^2}",
          "uso": "Pendiente de la recta de regresion."
        },
        {
          "nombre": "Intercepto",
          "formula": "a = \\bar{Y} - b\\cdot \\bar{X}",
          "uso": "Intercepto de la recta de regresion."
        },
        {
          "nombre": "Coeficiente de correlacion",
          "formula": "r = \\frac{n\\sum xy - \\sum x\\sum y}{\\sqrt{(n\\sum x^2-(\\sum x)^2)(n\\sum y^2-(\\sum y)^2)}}",
          "uso": "Mide la relacion lineal entre dos variables."
        },
        {
          "nombre": "Coeficiente de determinacion",
          "formula": "R^2 = r^2",
          "uso": "Proporcion de variacion explicada por el modelo."
        },
        {
          "nombre": "Variacion total",
          "formula": "SST = \\sum (y_i - \\bar{y})^2",
          "uso": "Variacion total de la variable dependiente."
        },
        {
          "nombre": "Variacion explicada",
          "formula": "SSR = \\sum (\\hat{y}_i - \\bar{y})^2",
          "uso": "Variacion explicada por la regresion."
        },
        {
          "nombre": "Variacion no explicada (residuos)",
          "formula": "SSE = \\sum (y_i - \\hat{y}_i)^2",
          "uso": "Variacion no explicada (error)."
        },
        {
          "nombre": "Descomposicion de la variacion",
          "formula": "SST = SSR + SSE",
          "uso": "Relacion entre variaciones total, explicada y no explicada."
        },
        {
          "nombre": "Residuo",
          "formula": "e_i = y_i - \\hat{y}_i",
          "uso": "Diferencia entre valor observado y predicho."
        },
        {
          "nombre": "Media aritmetica",
          "formula": "\\bar{x} = \\frac{\\sum x_i}{n}",
          "uso": "Medida de tendencia central."
        },
        {
          "nombre": "Mediana",
          "formula": "Me = x_{(n+1)/2}",
          "uso": "Valor central de los datos ordenados."
        },
        {
          "nombre": "Moda",
          "formula": "Mo",
          "uso": "Valor mas frecuente."
        },
        {
          "nombre": "Cuartiles",
          "formula": "Q_1, Q_2, Q_3",
          "uso": "Dividen los datos en cuatro partes iguales."
        },
        {
          "nombre": "Percentiles",
          "formula": "P_k",
          "uso": "Dividen los datos en 100 partes iguales."
        },
        {
          "nombre": "Varianza (muestra)",
          "formula": "s^2 = \\frac{\\sum (x_i-\\bar{x})^2}{n-1}",
          "uso": "Dispersion de los datos."
        },
        {
          "nombre": "Desvio estandar (muestra)",
          "formula": "s = \\sqrt{s^2}",
          "uso": "Dispersion en las mismas unidades de la variable."
        },
        {
          "nombre": "Rango",
          "formula": "R = x_{max}-x_{min}",
          "uso": "Diferencia entre el mayor y menor valor."
        },
        {
          "nombre": "Coeficiente de variacion",
          "formula": "CV = \\frac{s}{\\bar{x}}\\times 100",
          "uso": "Dispersion relativa."
        },
        {
          "nombre": "Asimetria (skewness)",
          "formula": "g_1 = \\frac{\\sum (x_i-\\bar{x})^3/n}{s^3}",
          "uso": "Medida de forma: simetria de la distribucion."
        },
        {
          "nombre": "Curtosis",
          "formula": "g_2 = \\frac{\\sum (x_i-\\bar{x})^4/n}{s^4}-3",
          "uso": "Medida de forma: apuntamiento de la distribucion."
        },
        {
          "nombre": "Modelo parabolico",
          "formula": "Y = a_0 + a_1 X + a_2 X^2",
          "uso": "Ajuste cuadratico."
        },
        {
          "nombre": "Modelo cubico",
          "formula": "Y = a_0 + a_1 X + a_2 X^2 + a_3 X^3",
          "uso": "Ajuste cubico."
        },
        {
          "nombre": "Modelo potencial",
          "formula": "Y = a\\,X^b",
          "uso": "Ajuste potencial."
        },
        {
          "nombre": "Modelo exponencial",
          "formula": "Y = a\\,b^X",
          "uso": "Ajuste exponencial."
        },
        {
          "nombre": "Error estandar de estimacion",
          "formula": "S_{y\\cdot x} = \\sqrt{\\frac{\\sum (y_i-\\hat{y}_i)^2}{n-2}}",
          "uso": "Dispersion de los puntos respecto a la recta."
        }
      ]
    },
    {
      "unidad": "Unidad III - Analisis de una variable en el tiempo",
      "formulas": [
        {
          "nombre": "Modelo aditivo",
          "formula": "Y = T + E + C + I",
          "uso": "Suma de componentes de la serie."
        },
        {
          "nombre": "Modelo multiplicativo",
          "formula": "Y = T \\times E \\times C \\times I",
          "uso": "Producto de componentes de la serie."
        },
        {
          "nombre": "Media movil",
          "formula": "\\bar{Y}_t = \\frac{Y_{t-1}+Y_t+Y_{t+1}}{3}",
          "uso": "Suavizar la serie para identificar la tendencia."
        },
        {
          "nombre": "Tendencia lineal",
          "formula": "Y = a + bX",
          "uso": "Estimar la tendencia por minimos cuadrados."
        },
        {
          "nombre": "Indice estacional",
          "formula": "I_e = \\frac{\\bar{Y}_{mes}}{\\bar{Y}}",
          "uso": "Medir la variacion estacional respecto al promedio."
        },
        {
          "nombre": "Error de pronostico",
          "formula": "e_t = Y_t - \\hat{Y}_t",
          "uso": "Diferencia entre valor real y pronosticado."
        },
        {
          "nombre": "Coeficiente de ajuste",
          "formula": "\\text{Coef. ajuste} = \\frac{\\sum Y}{\\sum \\hat{Y}}",
          "uso": "Relacion entre valores reales y ajustados (cercano a 1)."
        }
      ]
    },
    {
      "unidad": "Unidad IV - Analisis de una variable en el tiempo (II)",
      "formulas": [
        {
          "nombre": "Modelo multiplicativo",
          "formula": "Y = T \\times E \\times C \\times A",
          "uso": "Producto de los componentes de la serie (tendencia, estacional, ciclo, aleatorio)."
        },
        {
          "nombre": "Modelo aditivo",
          "formula": "Y = T + E + C + A",
          "uso": "Suma de los componentes de la serie."
        },
        {
          "nombre": "Tendencia lineal",
          "formula": "Y = a_1 + b_1\\,t",
          "uso": "Ajuste de la tendencia por minimos cuadrados."
        },
        {
          "nombre": "Pronostico por tendencia",
          "formula": "\\hat{Y} = a_1 + b_1\\,t_i",
          "uso": "Estimar el valor de la serie en un periodo t."
        },
        {
          "nombre": "Proyeccion mensual de la tendencia",
          "formula": "Y_t = a_{12} + b_{12}\\,t_{12} = a_{12} + \\frac{b_{12}}{12}\\,t",
          "uso": "Expresar la tendencia anual en valores mensuales."
        },
        {
          "nombre": "Coeficiente de ajuste",
          "formula": "\\text{Coef. ajuste} = \\frac{\\sum Y}{\\sum \\hat{Y}}",
          "uso": "Verificar el ajuste del modelo (debe ser cercano a 1)."
        },
        {
          "nombre": "Error de pronostico",
          "formula": "e_t = Y_t - \\hat{Y}_t",
          "uso": "Diferencia entre el valor real y el pronosticado."
        }
      ]
    },
    {
      "unidad": "Unidad V - Numeros indices",
      "formulas": [
        {
          "nombre": "Indice simple",
          "formula": "I = \\frac{P_1}{P_0}\\times 100",
          "uso": "Comparar un precio actual con el base."
        },
        {
          "nombre": "Indice agregativo simple",
          "formula": "I = \\frac{\\sum P_1}{\\sum P_0}\\times 100",
          "uso": "Indice no ponderado de precios."
        },
        {
          "nombre": "Laspeyres",
          "formula": "L = \\frac{\\sum P_1 Q_0}{\\sum P_0 Q_0}\\times 100",
          "uso": "Indice ponderado con cantidades base."
        },
        {
          "nombre": "Paasche",
          "formula": "P = \\frac{\\sum P_1 Q_1}{\\sum P_0 Q_1}\\times 100",
          "uso": "Indice ponderado con cantidades actuales."
        },
        {
          "nombre": "Fisher",
          "formula": "F = \\sqrt{L\\cdot P}",
          "uso": "Media geometrica de Laspeyres y Paasche."
        },
        {
          "nombre": "Variacion porcentual",
          "formula": "\\%\\Delta = \\frac{I_1 - I_0}{I_0}\\times 100",
          "uso": "Variacion porcentual entre dos periodos."
        },
        {
          "nombre": "Poder adquisitivo",
          "formula": "PA = \\frac{S}{I_p}",
          "uso": "Salario nominal dividido por indice de precios."
        },
        {
          "nombre": "Indice de valor",
          "formula": "I_V = \\frac{I_P \\cdot I_Q}{100}",
          "uso": "Producto de indices de precios y cantidad."
        },
        {
          "nombre": "Variacion (coeficiente)",
          "formula": "V_i = (C_i - 1)\\times 100",
          "uso": "Variacion porcentual a partir del coeficiente."
        },
        {
          "nombre": "Enlace de indices",
          "formula": "I_{i} = \\frac{I_i}{I_{i-1}}\\times I_{i-1}",
          "uso": "Encadenar indices de periodos consecutivos."
        },
        {
          "nombre": "Actualizacion monetaria",
          "formula": "\\text{Valor real} = \\frac{\\text{Valor nominal}}{\\text{Indice de precios}}\\times 100",
          "uso": "Expresar valores a precios de un periodo base."
        }
      ]
    },
    {
      "unidad": "Unidad VI - Probabilidad",
      "formulas": [
        {
          "nombre": "Probabilidad condicional",
          "formula": "P(A|B) = \\frac{P(A\\cap B)}{P(B)}",
          "uso": "Probabilidad de A dado que ocurrio B."
        },
        {
          "nombre": "Regla de la adicion",
          "formula": "P(A\\cup B) = P(A)+P(B)-P(A\\cap B)",
          "uso": "Probabilidad de que ocurra A o B."
        },
        {
          "nombre": "Regla de la multiplicacion",
          "formula": "P(A\\cap B) = P(A)\\cdot P(B|A)",
          "uso": "Probabilidad conjunta de dos sucesos."
        },
        {
          "nombre": "Esperanza matematica",
          "formula": "E(X) = \\sum x_i\\cdot p_i",
          "uso": "Valor esperado de una variable aleatoria discreta."
        },
        {
          "nombre": "Varianza",
          "formula": "\\text{Var}(X) = E(X^2) - [E(X)]^2",
          "uso": "Dispersion de la variable respecto a su media."
        },
        {
          "nombre": "Suceso complementario",
          "formula": "P(\\bar{A}) = 1 - P(A)",
          "uso": "Probabilidad de que no ocurra A."
        },
        {
          "nombre": "Probabilidad total",
          "formula": "P(A) = \\sum P(A\\cap B_i)",
          "uso": "Probabilidad de A a partir de sucesos exhaustivos B_i."
        },
        {
          "nombre": "Independencia",
          "formula": "P(A|B) = P(A) \\iff P(A\\cap B)=P(A)P(B)",
          "uso": "Condicion de independencia de dos sucesos."
        }
      ]
    },
    {
      "unidad": "Unidad VII - Distribuciones",
      "formulas": [
        {
          "nombre": "Binomial: P(X=k)",
          "formula": "P(X=k)=\\binom{n}{k}\\cdot p^k\\cdot q^{n-k}",
          "uso": "Probabilidad de k exitos en n ensayos."
        },
        {
          "nombre": "Binomial: E y Var",
          "formula": "E(X)=n\\cdot p \\; ; \\; \\text{Var}(X)=n\\cdot p\\cdot q",
          "uso": "Media y varianza de la Binomial."
        },
        {
          "nombre": "Poisson: P(X=k)",
          "formula": "P(X=k)=e^{-\\mu}\\cdot \\frac{\\mu^k}{k!}",
          "uso": "Probabilidad de k eventos en un intervalo."
        },
        {
          "nombre": "Normal estandar",
          "formula": "Z = \\frac{X-\\mu}{\\sigma}",
          "uso": "Estandarizar una variable normal."
        },
        {
          "nombre": "Hipergeometrica",
          "formula": "P(X=k)=\\frac{\\binom{K}{k}\\binom{N-K}{n-k}}{\\binom{N}{n}}",
          "uso": "Probabilidad en muestreo sin reposicion."
        },
        {
          "nombre": "Poisson: media y varianza",
          "formula": "E(X)=\\text{Var}(X)=\\mu",
          "uso": "Media igual a la varianza en la Poisson."
        },
        {
          "nombre": "Poisson: parametro",
          "formula": "\\lambda = n\\cdot p",
          "uso": "Aproximacion de la Binomial a la Poisson."
        }
      ]
    },
    {
      "unidad": "Unidad VIII - Muestras",
      "formulas": [
        {
          "nombre": "Total de muestras con reposicion",
          "formula": "M = N^n",
          "uso": "Cantidad de muestras de tamano n que pueden extraerse de una poblacion N con reposicion."
        },
        {
          "nombre": "Total de muestras sin reposicion",
          "formula": "M = \\binom{N}{n} = \\frac{N!}{n!\\,(N-n)!}",
          "uso": "Cantidad de muestras de tamano n sin reposicion (poblacion finita)."
        },
        {
          "nombre": "Media de la distribucion muestral de medias",
          "formula": "E(\\bar{x}) = \\mu_{\\bar{x}} = \\mu_x",
          "uso": "La media de las medias muestrales es igual a la media poblacional."
        },
        {
          "nombre": "Varianza de la media muestral (con reposicion)",
          "formula": "V(\\bar{x}) = \\sigma_{\\bar{x}}^2 = \\frac{\\sigma_x^2}{n}",
          "uso": "Dispersion de las medias muestrales en poblaciones infinitas."
        },
        {
          "nombre": "Error estandar de la media (con reposicion)",
          "formula": "\\sigma_{\\bar{x}} = \\frac{\\sigma_x}{\\sqrt{n}}",
          "uso": "Desvio estandar de la distribucion muestral de medias."
        },
        {
          "nombre": "Varianza de la media muestral (sin reposicion)",
          "formula": "V(\\bar{x}) = \\frac{\\sigma_x^2}{n}\\cdot\\frac{N-n}{N-1}",
          "uso": "Dispersion de las medias en poblaciones finitas."
        },
        {
          "nombre": "Error estandar de la media (sin reposicion)",
          "formula": "\\sigma_{\\bar{x}} = \\frac{\\sigma_x}{\\sqrt{n}}\\cdot\\sqrt{\\frac{N-n}{N-1}}",
          "uso": "Con factor de correccion para poblaciones finitas."
        },
        {
          "nombre": "Factor de correccion (poblaciones finitas)",
          "formula": "\\sqrt{\\frac{N-n}{N-1}}",
          "uso": "Corrige el error estandar cuando el muestreo es sin reposicion."
        },
        {
          "nombre": "Media de la proporcion muestral",
          "formula": "E(h_i) = \\mu_h = p",
          "uso": "La proporcion muestral es insesgada respecto de p."
        },
        {
          "nombre": "Varianza de la proporcion muestral (con reposicion)",
          "formula": "V(h_i) = \\sigma_h^2 = \\frac{p\\,q}{n}",
          "uso": "Dispersion de las proporciones muestrales."
        },
        {
          "nombre": "Error estandar de la proporcion",
          "formula": "\\sigma_h = \\sqrt{\\frac{p\\,q}{n}}",
          "uso": "Desvio estandar de la distribucion muestral de proporciones."
        },
        {
          "nombre": "Varianza de la proporcion (sin reposicion)",
          "formula": "V(h_i) = \\frac{p\\,q}{n}\\cdot\\frac{N-n}{N-1}",
          "uso": "Para poblaciones finitas o muestreo sin reposicion."
        },
        {
          "nombre": "Estandarizacion de la media muestral",
          "formula": "z = \\frac{\\bar{x}-\\mu_x}{\\sigma_x/\\sqrt{n}}",
          "uso": "Permite usar la tabla normal para calcular probabilidades de la media muestral."
        },
        {
          "nombre": "Intervalo central de las medias",
          "formula": "\\bar{x} \\pm z\\cdot\\frac{\\sigma_x}{\\sqrt{n}}",
          "uso": "Valores entre los que se encuentra un porcentaje dado de las medias muestrales."
        },
        {
          "nombre": "Esperanza del desvio estandar muestral",
          "formula": "E(S_x) = \\mu_{S_x} = \\sigma_x",
          "uso": "El desvio estandar muestral estima el desvio poblacional."
        },
        {
          "nombre": "Varianza del desvio estandar muestral",
          "formula": "V(S_x) = \\sigma_{S_x}^2 = \\frac{\\sigma_x^2}{2n}",
          "uso": "Dispersion del desvio estandar muestral para muestras grandes."
        }
      ]
    },
    {
      "unidad": "Unidad IX - Estimacion",
      "formulas": [
        {
          "nombre": "Estimador puntual de la media",
          "formula": "\\hat{\\mu}_x = \\bar{x}",
          "uso": "La media muestral estima la media poblacional."
        },
        {
          "nombre": "Estimador puntual de la proporcion",
          "formula": "\\hat{p} = h_i",
          "uso": "La proporcion muestral estima la proporcion poblacional."
        },
        {
          "nombre": "Estimador puntual de la varianza",
          "formula": "\\hat{\\sigma}_x^2 = S_x^2",
          "uso": "La varianza muestral estima la varianza poblacional."
        },
        {
          "nombre": "Esperanza de la media muestral",
          "formula": "E(\\bar{x}) = \\mu_x",
          "uso": "Demuestra que la media muestral es un estimador insesgado."
        },
        {
          "nombre": "Esperanza de la varianza muestral",
          "formula": "E(S_x^2) = \\frac{n-1}{n}\\,\\sigma_x^2",
          "uso": "Muestra que S_x² es un estimador viciado (sesgado)."
        },
        {
          "nombre": "Varianza corregida",
          "formula": "S_c^2 = \\frac{1}{n-1}\\sum (x_i-\\bar{x})^2",
          "uso": "Estimador insesgado de la varianza poblacional."
        },
        {
          "nombre": "Relacion entre varianzas",
          "formula": "S_c^2 = \\frac{n}{n-1}\\,S_x^2",
          "uso": "Correccion del vicio de la varianza muestral."
        },
        {
          "nombre": "Estandarizacion de la media",
          "formula": "z_i = \\frac{\\bar{x}-\\mu_x}{\\sigma_x/\\sqrt{n}}",
          "uso": "Variable normal estandar usada para construir el intervalo."
        },
        {
          "nombre": "Intervalo de confianza para la media",
          "formula": "\\bar{x}-z_1\\frac{S_x}{\\sqrt{n}} \\leq \\mu_x \\leq \\bar{x}+z_1\\frac{S_x}{\\sqrt{n}}",
          "uso": "Estimacion por intervalos de la media (muestras grandes)."
        },
        {
          "nombre": "Intervalo de confianza para la proporcion",
          "formula": "h_i-z_1\\sqrt{\\frac{h_i(1-h_i)}{n}} \\leq p \\leq h_i+z_1\\sqrt{\\frac{h_i(1-h_i)}{n}}",
          "uso": "Estimacion por intervalos de una proporcion (muestras grandes)."
        },
        {
          "nombre": "Intervalo de confianza para el desvio estandar",
          "formula": "S_x-z_1\\frac{S_x}{\\sqrt{2n}} \\leq \\sigma_x \\leq S_x+z_1\\frac{S_x}{\\sqrt{2n}}",
          "uso": "Estimacion por intervalos del desvio estandar poblacional."
        },
        {
          "nombre": "Intervalo de confianza para la varianza",
          "formula": "\\left(S_x-z_1\\frac{S_x}{\\sqrt{2n}}\\right)^2 \\leq \\sigma_x^2 \\leq \\left(S_x+z_1\\frac{S_x}{\\sqrt{2n}}\\right)^2",
          "uso": "Se obtiene elevando al cuadrado los limites del desvio."
        },
        {
          "nombre": "Estadistico t de Student",
          "formula": "t = \\frac{\\bar{x}-\\mu_x}{S_c/\\sqrt{n}}",
          "uso": "Estandarizacion para muestras pequenas (n <= 30)."
        },
        {
          "nombre": "Grados de libertad",
          "formula": "v = n-1",
          "uso": "Parametro de la distribucion t y chi cuadrado."
        },
        {
          "nombre": "Intervalo de confianza para la media (muestras pequenas)",
          "formula": "\\bar{x}-t_1\\frac{S_c}{\\sqrt{n}} \\leq \\mu_x \\leq \\bar{x}+t_1\\frac{S_c}{\\sqrt{n}}",
          "uso": "Intervalo con t de Student cuando n <= 30."
        },
        {
          "nombre": "Intervalo de confianza para la varianza (chi cuadrado)",
          "formula": "\\frac{n\\,S_x^2}{\\chi_1^2} \\leq \\sigma_x^2 \\leq \\frac{n\\,S_x^2}{\\chi_2^2}",
          "uso": "Intervalo para la varianza usando chi cuadrado."
        },
        {
          "nombre": "Tamano de muestra (poblacion infinita)",
          "formula": "n = \\frac{z_1^2\\,\\sigma_x^2}{d^2}",
          "uso": "Tamano necesario para estimar la media con margen de error d."
        },
        {
          "nombre": "Tamano de muestra (poblacion finita)",
          "formula": "n = \\frac{N\\,z_1^2\\,\\sigma_x^2}{d^2(N-1)+z_1^2\\,\\sigma_x^2}",
          "uso": "Tamano de muestra para poblaciones finitas o sin reposicion."
        },
        {
